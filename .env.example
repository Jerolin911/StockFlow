# Configuration for docker-compose.yml (the production-style stack). Copy to .env and fill in.
#   cp .env.example .env

# Required. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Optional: creates the first admin when the database has no users. A password change is
# required at first sign-in. Not needed if you load the demo data (docker compose run --rm seed).
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Port the web app (and /api) is served on: http://localhost:8080
WEB_PORT=8080
# MongoDB is published on 127.0.0.1 only, for tools such as MongoDB Compass.
MONGO_PORT=27018

# Secure cookies work on http://localhost and behind HTTPS. Set to false only when serving plain
# HTTP on another hostname (for example a LAN IP), which you shouldn't do in production.
COOKIE_SECURE=true
# Swagger UI at /api/v1/docs and the spec at /api/v1/openapi.json.
API_DOCS=true
# Sign-in attempts per 15 minutes per IP and email.
LOGIN_RATE_LIMIT=10

# Demo data password (docker compose run --rm seed). Defaults to the one in the README.
SEED_PASSWORD=

# Prebuilt images instead of building locally, e.g. ghcr.io/<owner>/stockflow-api:latest
# API_IMAGE=
# WEB_IMAGE=
