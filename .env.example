# Used by docker-compose.yml. Copy to .env and fill in.
JWT_ACCESS_SECRET=
# Creates the first admin on an empty database; a password change is required at first sign-in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
WEB_PORT=8080
# Secure cookies work on http://localhost. Set to false only for plain-HTTP access via another hostname.
COOKIE_SECURE=true
