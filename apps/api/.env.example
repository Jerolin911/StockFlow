NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/stockflow?replicaSet=rs0

# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_ACCESS_SECRET=

# Required. Master keys that encrypt each customer's data key (envelope encryption), as a
# comma-separated list of id:key, where each key is 32 random bytes in base64. The first one
# encrypts new keys; keep older ones after it until `npm run privacy:rotate-key -w @stockflow/api`
# reports none left under them. Losing every key makes all customer personal data unreadable.
# Generate one with:
#   node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEYS=

# Required. 32 random bytes in base64 for the keyed hash that lets customers be found by exact
# email. Never change it: existing emails would no longer be found. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BLIND_INDEX_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Defaults to true in production. Set to false only when serving over plain HTTP on a non-localhost host.
# COOKIE_SECURE=

# Comma-separated browser origins allowed to call the API directly. Not needed when the web app proxies /api.
CORS_ORIGINS=
TRUST_PROXY=loopback
LOGIN_RATE_LIMIT=10

# Swagger UI at /api/v1/docs and the OpenAPI document at /api/v1/openapi.json.
API_DOCS=true
# fatal, error, warn, info, debug, trace or silent. Defaults to info.
# LOG_LEVEL=

# Creates the first admin when the users collection is empty. A password change is required at first sign-in.
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
